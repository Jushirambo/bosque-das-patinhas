name: testes

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

jobs:
  engine:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 20
      - name: Regras e simulações
        run: node tests/engine.test.js

# COMO ATIVAR:
# O GitHub recusa pushes que criam arquivos em .github/workflows quando o token
# não tem a permissão "Workflows: Read and write". Duas opções:
#
# 1) Token com permissão Workflows (fine-grained: Workflows = Read and write),
#    ou classic com escopo `workflow`:
#      mkdir -p .github/workflows
#      git mv tools/ci-workflow.yml.example .github/workflows/test.yml
#      git commit -m "ci: roda os testes do motor no GitHub Actions"
#      git push
#
# 2) Sem mexer no token: no site do GitHub, use "Add file > Create new file",
#    digite .github/workflows/test.yml e cole o conteúdo acima (sem este bloco).
